{
  "name": "@wengine-ai/pi-quality-gates",
  "version": "0.3.0",
  "description": "Quality gates for pi coding-agent: settle-time rework loop + instant lint injection after edits. Host-agnostic core; ships as a pi extension package.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "keywords": [
    "pi",
    "pi-package",
    "pi-coding-agent",
    "quality",
    "lint",
    "verification",
    "settle-gate"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./dist/index.js"
    },
    "./core/settle": {
      "types": "./src/core/settle.ts",
      "default": "./dist/core/settle.js"
    },
    "./core/runner": {
      "types": "./src/core/runner.ts",
      "default": "./dist/core/runner.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
